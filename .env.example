# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real API keys.

# ── Directory Paths ────────────────────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_VECTOR_STORE_DIR=data/vector_store
EXPERIMENTS_DIR=experiments/results

# ── Corpus Locations (override if your datasets live elsewhere) ───────────────
REUTERS_DIR=data/raw/reuters
STUDENT_ESSAY_DIR=data/raw/student_essays
PAN2024_DIR=data/raw/pan2024
PAN2023_DIR=data/raw/pan2023
BLOG_AUTHORSHIP_DIR=data/raw/blog_authorship
CEFR_WORDLIST_PATH=data/raw/ENGLISH_CEFR_WORDS.csv

# ── LLM API Keys ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Agent Models ───────────────────────────────────────────────────────────────
# Use gpt-4o-mini for development; swap to stronger models for final eval runs.
ANALYST_MODEL=gpt-4o-mini
SKEPTIC_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=3
FAISS_INDEX_PATH=data/vector_store/faiss.index
FAISS_METADATA_PATH=data/vector_store/metadata.jsonl

# ── NLP / Feature Extraction ───────────────────────────────────────────────────
SPACY_MODEL=en_core_web_md
GPT2_MODEL=gpt2
RANDOM_SEED=42
